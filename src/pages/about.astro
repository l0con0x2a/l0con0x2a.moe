---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_AUTHOR, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`このブログについて | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>このブログについて</h1>
			<p>{SITE_AUTHOR}の個人ブログです。いろいろなことを投稿していきます。</p>
		</main>
		<Footer />
	</body>
</html>
